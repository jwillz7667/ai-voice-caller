# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore, with the addition of
# "#!include" directives (which insert the entries of the given .gitignore-style
# file at that point).

.gcloudignore
.git
.gitignore

# Node.js dependencies
node_modules/
npm-debug.log
yarn-error.log

# Next.js build output
.next/
out/
build/
dist/

# Environment files
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Test files
*.test.js
*.spec.js
__tests__/
coverage/

# Documentation
*.md
docs/
README.md

# Development files
*.log
*.pid
*.seed
*.pid.lock
.npm/

# TypeScript
*.tsbuildinfo

# Temporary files
tmp/
temp/