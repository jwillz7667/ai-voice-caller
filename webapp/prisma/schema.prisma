generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                  String   @id
  user_id             String
  type                String
  provider            String
  provider_account_id String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  metadata            Json?
  created_at          DateTime @default(now())
  updated_at          DateTime
  users               users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id])
}

model analytics {
  id         String   @id
  user_id    String?
  event      String
  properties Json?
  timestamp  DateTime @default(now())
  session_id String?
  ip         String?
  user_agent String?
  referrer   String?
  country    String?
  city       String?

  @@index([event])
  @@index([session_id])
  @@index([timestamp])
  @@index([user_id])
}

model api_keys {
  id           String    @id
  user_id      String
  name         String
  key          String    @unique
  hashed_key   String    @unique
  scopes       String[]  @default([])
  expires_at   DateTime?
  last_used_at DateTime?
  last_used_ip String?
  usage_count  Int       @default(0)
  active       Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([hashed_key])
  @@index([key])
  @@index([user_id])
}

model audit_logs {
  id         String   @id
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  old_values Json?
  new_values Json?
  metadata   Json?
  ip         String?
  user_agent String?
  created_at DateTime @default(now())
  users      users?   @relation(fields: [user_id], references: [id])

  @@index([action])
  @@index([created_at])
  @@index([entity])
  @@index([user_id])
}

model call_events {
  id          String    @id
  call_log_id String
  event_type  String
  event_data  Json?
  timestamp   DateTime
  created_at  DateTime  @default(now())
  call_logs   call_logs @relation(fields: [call_log_id], references: [id], onDelete: Cascade)

  @@index([call_log_id])
  @@index([event_type])
  @@index([timestamp])
}

model call_logs {
  id                String        @id
  user_id           String?
  session_id        String        @unique
  call_sid          String?       @unique
  phone_number      String
  direction         CallDirection
  duration          Int           @default(0)
  status            CallStatus
  credits_used      Int           @default(0)
  cost              Float         @default(0)
  from_number       String?
  to_number         String?
  recording_enabled Boolean       @default(false)
  model             String?
  voice             String?
  instructions      String?
  configuration     Json?
  transcript        Json?
  summary           String?
  sentiment         String?
  keywords          String[]      @default([])
  metadata          Json?
  latency_ms        Int?
  tokens_used       Int?
  error_count       Int           @default(0)
  started_at        DateTime?
  answered_at       DateTime?
  ended_at          DateTime?
  created_at        DateTime      @default(now())
  updated_at        DateTime
  call_events       call_events[]
  users             users?        @relation(fields: [user_id], references: [id])
  recordings        recordings?

  @@index([call_sid])
  @@index([created_at])
  @@index([direction])
  @@index([session_id])
  @@index([status])
  @@index([user_id])
}

model credit_transactions {
  id                String          @id
  user_id           String
  amount            Int
  balance           Int
  transaction_type  TransactionType
  payment_id        String?
  stripe_payment_id String?
  description       String?
  metadata          Json?
  created_at        DateTime        @default(now())
  users             users           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([transaction_type])
  @@index([user_id])
}

model email_verifications {
  id         String    @id
  user_id    String
  email      String
  token      String    @unique
  expires    DateTime
  used       Boolean   @default(false)
  used_at    DateTime?
  created_at DateTime  @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([user_id])
}

model incoming_call_configs {
  id                          String    @id
  user_id                     String
  name                        String    @default("Default Incoming Call Configuration")
  is_active                   Boolean   @default(true)
  model                       String    @default("gpt-realtime")
  instructions                String
  voice                       String    @default("marin")
  temperature                 Float     @default(0.8)
  max_tokens                  Int       @default(4096)
  tools                       Json      @default("[]")
  turn_detection              Json      @default("{\"type\": \"semantic_vad\", \"eagerness\": \"auto\", \"threshold\": 0.5, \"create_response\": true, \"prefix_padding_ms\": 300, \"interrupt_response\": true, \"silence_duration_ms\": 500}")
  input_audio_format          String    @default("pcm16")
  output_audio_format         String    @default("pcm16")
  input_audio_transcription   Json?
  metadata                    Json?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime
  automatic_gain_control      Boolean   @default(true)
  conversation_id             String?
  echo_cancellation           Boolean   @default(true)
  enable_images               Boolean   @default(false)
  enable_mcp                  Boolean   @default(false)
  enable_sip                  Boolean   @default(true)
  max_output_tokens           Int?
  max_response_output_tokens  Int?
  modalities                  Json?     @default("[\"text\", \"audio\"]")
  noise_reduction             Boolean   @default(true)
  parallel_tool_calls         Boolean   @default(true)
  response_mode               String    @default("streaming")
  tool_choice                 String    @default("auto")
  audio_config                Json?
  config_type                 String    @default("realtime")
  input_audio_noise_reduction Json?
  last_used_at                DateTime?
  output_audio_gain           Float?    @default(1.0)
  prompt_config               Json?
  record_call                 Boolean   @default(true)
  transcription_language      String?   @default("en")
  transcription_model         String?   @default("gpt-4o-transcribe")
  transcription_prompt        String?
  usage_count                 Int       @default(0)
  version                     Int       @default(1)
  users                       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, is_active])
  @@index([is_active])
  @@index([last_used_at])
  @@index([model])
  @@index([user_id])
  @@index([voice])
}

model invites {
  id                                   String         @id
  email                                String
  role                                 OrgRole        @default(MEMBER)
  token                                String         @unique
  org_id                               String?
  invited_by_id                        String
  invited_user_id                      String?
  status                               InviteStatus   @default(PENDING)
  expires_at                           DateTime
  accepted_at                          DateTime?
  created_at                           DateTime       @default(now())
  users_invites_invited_by_idTousers   users          @relation("invites_invited_by_idTousers", fields: [invited_by_id], references: [id])
  users_invites_invited_user_idTousers users?         @relation("invites_invited_user_idTousers", fields: [invited_user_id], references: [id])
  organizations                        organizations? @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([org_id])
  @@index([token])
}

model notifications {
  id         String           @id
  user_id    String
  type       NotificationType
  title      String
  message    String
  data       Json?
  read       Boolean          @default(false)
  read_at    DateTime?
  created_at DateTime         @default(now())
  users      users            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([read])
  @@index([type])
  @@index([user_id])
}

model organization_members {
  id            String        @id
  user_id       String
  org_id        String
  role          OrgRole       @default(MEMBER)
  permissions   String[]      @default([])
  joined_at     DateTime      @default(now())
  organizations organizations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  users         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, org_id])
  @@index([org_id])
  @@index([user_id])
}

model organizations {
  id                   String                 @id
  name                 String
  slug                 String                 @unique
  description          String?
  logo_url             String?
  website              String?
  stripe_customer_id   String?                @unique
  billing_email        String?
  plan                 String                 @default("free")
  credits              Int                    @default(1000)
  settings             Json?
  metadata             Json?
  status               OrganizationStatus     @default(ACTIVE)
  created_at           DateTime               @default(now())
  updated_at           DateTime
  invites              invites[]
  organization_members organization_members[]

  @@index([slug])
}

model password_resets {
  id         String    @id
  user_id    String
  token      String    @unique
  expires    DateTime
  used       Boolean   @default(false)
  used_at    DateTime?
  created_at DateTime  @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([user_id])
}

model rate_limits {
  id            String    @id
  identifier    String
  endpoint      String
  count         Int       @default(1)
  window        String
  blocked_until DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime

  @@unique([identifier, endpoint, window])
  @@index([blocked_until])
  @@index([identifier])
}

model realtime_sessions {
  id                String    @id
  user_id           String
  session_id        String    @unique
  call_sid          String?   @unique
  configuration     Json
  model             String?
  voice             String?
  vad_mode          String?
  status            String    @default("active")
  is_active         Boolean   @default(true)
  latency_ms        Int?
  audio_quality     String?
  connection_errors Int       @default(0)
  reconnect_count   Int       @default(0)
  total_duration    Int       @default(0)
  credits_used      Int       @default(0)
  tokens_used       Int       @default(0)
  started_at        DateTime
  ended_at          DateTime?
  last_activity     DateTime  @default(now())
  created_at        DateTime  @default(now())
  updated_at        DateTime
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([call_sid])
  @@index([is_active])
  @@index([session_id])
  @@index([started_at])
  @@index([status])
  @@index([user_id])
}

model recordings {
  id                String          @id
  call_log_id       String          @unique
  recording_sid     String          @unique
  recording_url     String
  public_url        String?
  duration          Int
  channels          Int             @default(1)
  status            RecordingStatus @default(PROCESSING)
  size              Int?
  format            String?
  transcription_url String?
  created_at        DateTime        @default(now())
  call_logs         call_logs       @relation(fields: [call_log_id], references: [id], onDelete: Cascade)

  @@index([status])
}

model saved_configurations {
  id            String    @id
  user_id       String
  name          String
  description   String?
  category      String?
  configuration Json
  is_public     Boolean   @default(false)
  is_template   Boolean   @default(false)
  usage_count   Int       @default(0)
  rating        Float?
  tags          String[]  @default([])
  last_used_at  DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([is_public])
  @@index([is_template])
  @@index([user_id])
}

model sessions {
  id            String   @id
  session_token String   @unique
  user_id       String
  expires       DateTime
  user_agent    String?
  ip            String?
  last_activity DateTime @default(now())
  created_at    DateTime @default(now())
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires])
  @@index([session_token])
  @@index([user_id])
}

model system_health {
  id         String   @id
  service    String
  status     String
  latency    Int?
  uptime     Float?
  errorRate  Float?
  metadata   Json?
  checked_at DateTime @default(now())

  @@index([checked_at])
  @@index([service])
  @@index([status])
}

model users {
  id                                     String                  @id
  email                                  String                  @unique
  email_verified                         Boolean                 @default(false)
  email_verified_at                      DateTime?
  password                               String?
  name                                   String?
  username                               String?                 @unique
  phone                                  String?
  phone_verified                         Boolean                 @default(false)
  company                                String?
  job_title                              String?
  avatar_url                             String?
  bio                                    String?
  timezone                               String                  @default("UTC")
  locale                                 String                  @default("en")
  status                                 UserStatus              @default(ACTIVE)
  role                                   UserRole                @default(USER)
  permissions                            String[]                @default([])
  two_factor_enabled                     Boolean                 @default(false)
  two_factor_secret                      String?
  last_login_at                          DateTime?
  last_login_ip                          String?
  login_count                            Int                     @default(0)
  failed_login_count                     Int                     @default(0)
  locked_until                           DateTime?
  credits                                Int                     @default(100)
  credit_balance                         Float                   @default(0)
  stripe_customer_id                     String?                 @unique
  metadata                               Json?
  tags                                   String[]                @default([])
  created_at                             DateTime                @default(now())
  updated_at                             DateTime
  deleted_at                             DateTime?
  accounts                               accounts[]
  api_keys                               api_keys[]
  audit_logs                             audit_logs[]
  call_logs                              call_logs[]
  credit_transactions                    credit_transactions[]
  email_verifications                    email_verifications[]
  incoming_call_configs                  incoming_call_configs[]
  invites_invites_invited_by_idTousers   invites[]               @relation("invites_invited_by_idTousers")
  invites_invites_invited_user_idTousers invites[]               @relation("invites_invited_user_idTousers")
  notifications                          notifications[]
  organization_members                   organization_members[]
  password_resets                        password_resets[]
  realtime_sessions                      realtime_sessions[]
  saved_configurations                   saved_configurations[]
  sessions                               sessions[]
  webhooks                               webhooks[]

  @@index([created_at])
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([username])
}

model webhook_logs {
  id          String   @id
  webhook_id  String
  event       String
  payload     Json
  response    Json?
  status_code Int?
  success     Boolean
  error       String?
  duration    Int?
  created_at  DateTime @default(now())
  webhooks    webhooks @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([event])
  @@index([success])
  @@index([webhook_id])
}

model webhooks {
  id             String         @id
  user_id        String
  url            String
  events         String[]
  secret         String
  active         Boolean        @default(true)
  failure_count  Int            @default(0)
  last_triggered DateTime?
  metadata       Json?
  created_at     DateTime       @default(now())
  updated_at     DateTime
  webhook_logs   webhook_logs[]
  users          users          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([user_id])
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INITIATED
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
  CANCELLED
  TIMEOUT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  CALL_COMPLETED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  CREDITS_LOW
  SYSTEM
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
}

enum RecordingStatus {
  PROCESSING
  COMPLETED
  FAILED
  DELETED
}

enum TransactionType {
  PURCHASE
  USAGE
  REFUND
  BONUS
  TRANSFER
  ADJUSTMENT
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  USER
  GUEST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  BANNED
}
