# Frontend Environment Variables Template
# Copy this file to .env.local and fill in your values

# WebSocket Server URL
# Development: ws://localhost:8081
# Production: wss://your-cloud-run-url.run.app
NEXT_PUBLIC_WEBSOCKET_URL="wss://ai-voice-caller-public-995705962018.us-central1.run.app"

# Backend API URL
# Development: http://localhost:8081
# Production: https://your-cloud-run-url.run.app
BACKEND_URL="https://ai-voice-caller-public-995705962018.us-central1.run.app"
PUBLIC_URL="https://ai-voice-caller-public-995705962018.us-central1.run.app"

# Authentication bypass (set to false in production with real auth)
NEXT_PUBLIC_AUTH_BYPASS=false

# Redis (for session caching and rate limiting)
REDIS_URL="redis://localhost:6379"

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/ai_voice_caller?schema=public"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"

# Stripe (for token purchasing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Price IDs for token packages
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_STANDARD=""
STRIPE_PRICE_PREMIUM=""
STRIPE_PRICE_ENTERPRISE=""

# Twilio (for server-side operations)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
