{
  "name": "twilio-realtime",
  "version": "1.0.0",
  "description": "Twilio real-time server with TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run copy-files",
    "copy-files": "cp -r src/twiml.xml dist/",
    "start": "node dist/server.js",
    "dev": "nodemon --watch 'src/**/*' --watch '.env' --ext 'ts,js,xml,env' --exec 'ts-node' src/server.ts",
    "dev:port": "nodemon --watch 'src/**/*' --watch '.env' --ext 'ts,js,xml,env' --exec 'ts-node src/server.ts'",
    "start:ngrok": "node scripts/start-with-ngrok.js",
    "sync:ngrok": "node scripts/watch-ngrok-and-sync.js",
    "update:twilio-webhook": "node scripts/update-twilio-webhook.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.14.0",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.17",
    "@types/dotenv": "8.2.0",
    "@types/express": "5.0.0",
    "@types/node": "22.0.0",
    "@types/ws": "8.5.12",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "express-rate-limit": "7.1.5",
    "handlebars": "4.7.8",
    "httpdispatcher": "2.2.0",
    "ioredis": "5.7.0",
    "jsonwebtoken": "9.0.2",
    "prisma": "6.14.0",
    "stripe": "17.7.0",
    "ts-node": "10.9.2",
    "twilio": "5.9.0",
    "typescript": "5.5.4",
    "ws": "8.18.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "@typescript-eslint/parser": "8.43.0",
    "@vitest/ui": "1.1.0",
    "eslint": "9.35.0",
    "ngrok": "4.3.3",
    "nodemon": "3.1.9",
    "supertest": "6.3.3",
    "vitest": "1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prisma": {
    "schema": "../webapp/prisma/schema.prisma"
  }
}
