# WebSocket Server Environment Variables Template
# Copy this file to .env.local and fill in your values

# Server Configuration
PORT=8080  # 8080 for Cloud Run, 8081 for local development
NODE_ENV=production  # or 'development'

# Public URLs - Required for Twilio webhooks
PUBLIC_URL=https://your-websocket-server.com
WS_PUBLIC_URL=wss://your-websocket-server.com

# Frontend Configuration
WEBAPP_URL=https://your-frontend-domain.com
ALLOWED_ORIGIN=https://your-frontend-domain.com

# OpenAI Configuration - Required
OPENAI_API_KEY=sk-proj-YOUR-OPENAI-API-KEY
OPENAI_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_MODEL_URL=  # Optional: Override the default WebSocket URL

# OpenAI SIP Configuration - Optional
OPENAI_SIP_URI=sip:realtime.openai.com:5060;transport=tls?model=gpt-4o-realtime-preview-2024-12-17&voice=verse

# Twilio Configuration - Required for phone calls
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Optional Configuration
OPENAI_VOICES=verse,alloy,echo,shimmer,nova,fable  # Available voices
REDIS_URL=redis://localhost:6379  # For session persistence
SENTRY_DSN=  # For error monitoring
LOG_LEVEL=info  # debug, info, warn, error