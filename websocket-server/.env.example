# WebSocket Server Environment Variables
# Copy this file to .env and fill in your values

# Core Configuration
PORT=8081
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGIN=http://localhost:3000

# OpenAI Configuration
OPENAI_API_KEY="your-openai-api-key"

# Twilio Configuration
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Public URL (ngrok in dev, your domain in production)
PUBLIC_URL=""

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/ai_voice_caller?schema=public"

# JWT Configuration (generate with: openssl rand -base64 32)
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"

# Redis Configuration (for session caching and rate limiting)
REDIS_URL="redis://localhost:6379"

# Stripe Configuration (for token purchasing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Price IDs for token packages
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_STANDARD=""
STRIPE_PRICE_PREMIUM=""
STRIPE_PRICE_ENTERPRISE=""

# Optional Voice Configuration
# Comma-separated list or JSON array of available voices
# OPENAI_VOICES="alloy,ash,ballad,cedar,coral,echo,marin,sage,shimmer,verse"
# OPENAI_VOICES_JSON='["alloy","ash","ballad","cedar","coral","echo","marin","sage","shimmer","verse"]'